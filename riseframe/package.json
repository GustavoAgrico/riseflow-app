{
  "name": "riseframe",
  "version": "0.91.0",
  "private": true,
  "description": "Editor de vídeo web com IA — MVP do pipeline (corte de silêncio, legendas, B-roll, color grade).",
  "type": "module",
  "main": "electron/main.js",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "dev:electron": "electron .",
    "dev:all": "concurrently -n server,web,electron -c cyan,magenta,green \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:electron\"",
    "build": "npm --workspace web run build",
    "build:desktop": "npm run build && electron-builder --publish never",
    "start": "npm --workspace server run start",
    "sample": "npm --workspace server run sample",
    "test": "npm --workspace server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.0.1",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16"
  },
  "engines": {
    "node": ">=20"
  }
}
