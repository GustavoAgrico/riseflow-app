# Configuração do deploy do Riseframe (copie para .env e edite).
#   cp .env.example .env

# ── OBRIGATÓRIO ─────────────────────────────────────────────────────
# Endereço público do site (SEM https://). Duas formas:
#   • Sem domínio próprio: use o IP da VM com sslip.io  → ex.: 123.45.67.89.sslip.io
#   • Com domínio: aponte um registro A do seu domínio para o IP e use  app.seudominio.com
SITE_ADDRESS=123.45.67.89.sslip.io

# Segredo para assinar os tokens de login. Gere um forte, ex.:
#   openssl rand -hex 32
AUTH_SECRET=troque-por-uma-string-longa-e-aleatoria

# ── Transcrição (legendas) ──────────────────────────────────────────
# Deepgram (recomendado): rápido e preciso — use a MESMA chave que está no Render.
# Sem chave, troque para whisper-local (grátis, roda na própria VM, mais lento).
TRANSCRIBE_PROVIDER=deepgram
DEEPGRAM_API_KEY=
WHISPER_MODEL=base            # só para whisper-local: tiny|base|small|medium

# ── Opcionais ───────────────────────────────────────────────────────
OUTPUT_TTL_HOURS=24           # limpa renders antigos após N horas
# Sem limite de tamanho por padrão. Para limitar: MAX_UPLOAD_GB=50
# MAX_UPLOAD_GB=

# B-roll automático (banco gratuito Pexels)
PEXELS_API_KEY=

# Imagens do Google no B-roll (Programmable Search). Mesmos valores do Render.
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Correção de fala + color grade por IA (Claude)
ANTHROPIC_API_KEY=

# Outras APIs de transcrição (alternativas à Deepgram)
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=

# Login com Google (Client ID "Web" do Google Cloud). Adicione https://SITE_ADDRESS nas Authorized origins.
GOOGLE_CLIENT_ID=

# Recuperação de senha por e-mail (SMTP). Ex.: Gmail com senha de app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Planos e créditos (AbacatePay: Pix/cartão) ──────────────────────
# Os limites de créditos valem sempre; sem a chave, ninguém consegue assinar.
# Webhook na AbacatePay (atualize quando trocar de servidor/domínio):
#   https://SITE_ADDRESS/api/billing/webhook?webhookSecret=MESMO_VALOR_ABAIXO
ABACATE_PAY_API_KEY=
# Forma de cobrança: pix-links (padrão: links de Pix do banco + confirmação do admin)
# ou abacatepay. Links por plano: BILLING_PIX_LINKS='{"basico":"https://...","pro":"...","premium":"..."}'
# BILLING_PAYMENT=pix-links
# Lembretes de vencimento (dias antes; 0 = no vencimento): BILLING_REMINDER_DAYS=[3,1,0]
# WhatsApp do admin para avisos de "Já paguei" (com DDD): ADMIN_WHATSAPP=
# Envio de WhatsApp pelo servidor do RiseFlow (Baileys): mesma URL/chave do riseflow-wa
# (BAILEYS_URL / API_KEY) e o user id da conta do RiseFlow com o WhatsApp conectado.
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=
# WHATSAPP_SESSION_USER_ID=
# E-mails (confirmação e lembretes) usam o SMTP: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM
# Versão da API da chave (1 ou 2). Vazio = descobre sozinho (chaves novas são v2).
# ABACATE_API_VERSION=
# Renovação automática mensal no cartão (assinatura na AbacatePay, precisa da chave v2).
# BILLING_AUTO_RENEW=off esconde a opção. Métodos da assinatura (padrão CARD):
# BILLING_SUBSCRIPTION_METHODS=CARD
ABACATE_WEBHOOK_SECRET=
ADMIN_EMAILS=                 # seu e-mail: uso ilimitado, sem pagar
# BILLING_METHODS=PIX         # descomente se a AbacatePay recusar cartão
