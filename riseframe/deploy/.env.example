# Configuração do Riseframe no servidor. O ./install.sh cria o .env a partir deste
# arquivo e pergunta o essencial. Para editar depois:  nano .env  →  ./update.sh
# (Linhas com # são comentários. Não coloque espaço antes/depois do "=".)

# ═══ 1. ENDEREÇO DO SITE (obrigatório) ═══════════════════════════════
# Endereço principal, SEM https://. Ex.: www.riseframe.com.br
# Sem domínio ainda? Use o IP da VPS com sslip.io → 123.45.67.89.sslip.io
SITE_ADDRESS=www.riseframe.com.br
# Outros endereços que redirecionam para o principal (opcional).
SITE_ALIASES=riseframe.com.br

# Segredo dos logins (o install.sh gera sozinho). Trocar desloga todo mundo.
AUTH_SECRET=

# Seu e-mail de administrador (uso ilimitado, painel de pagamentos). Vários: vírgula.
ADMIN_EMAILS=

# ═══ 2. CHAVES DAS APIs (copie as mesmas do Render → Environment) ═══
# Transcrição/legendas (Deepgram).
TRANSCRIBE_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Imagens de apoio (B-roll): Pexels e Google (Programmable Search).
PEXELS_API_KEY=
PIXABAY_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# "Google Imagens" no B-roll sem a API do Google (fechada para contas novas, desliga em 2027):
SERPER_API_KEY=
BRAVE_SEARCH_KEY=
# IA (limpeza de fala e B-roll mais relevante): Claude.
ANTHROPIC_API_KEY=

# ── Contas, planos e Pix salvos no Supabase (sobrevivem a reinstalações) ──
# Mesmos valores do Render → Environment. Supabase → Project Settings → API Keys → service_role.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ── E-mail pelo Resend (código de confirmação, aviso de Pix, lembretes) ──
RESEND_API_KEY=
# Depois de verificar o domínio no Resend: Riseframe <nao-responda@riseframe.com.br>
EMAIL_FROM=
# ── Transcrição reserva/barata (console.groq.com → API Keys) ──
GROQ_API_KEY=
# Login com Google (opcional). No Google Cloud, adicione https://SITE_ADDRESS em
# "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# ═══ 3. COBRANÇA ═════════════════════════════════════════════════════
# Pix pelos links do banco + confirmação do admin (padrão). Os links do Básico, Pro
# e Premium já vêm no código; para trocar:
#   BILLING_PIX_LINKS={"basico":"https://...","pro":"https://...","premium":"https://..."}
BILLING_PAYMENT=pix-links
# Edições grátis de teste por conta (todos os recursos).
BILLING_FREE_EDITS=3
BILLING_SIGNUP_CREDITS=0
BILLING_PERIOD_DAYS=30
# Planos, recargas, custo por recurso e formas de pagamento (JSON, iguais aos do Render;
# vazio = padrão do app).
BILLING_PLANS=
CREDIT_PACKS=
CREDIT_COSTS=
BILLING_METHODS=
# WhatsApp do admin para avisos de "Já paguei" (com DDD).
ADMIN_WHATSAPP=
# AbacatePay (só se BILLING_PAYMENT=abacatepay):
ABACATE_PAY_API_KEY=
ABACATE_WEBHOOK_SECRET=

# ═══ 4. AVISOS POR E-MAIL E WHATSAPP (opcional) ══════════════════════
# E-mail (confirmação de pagamento, lembrete de vencimento, recuperar senha).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=seu@gmail.com, SMTP_PASS=senha de app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# WhatsApp automático pelo servidor do RiseFlow (Baileys).
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SESSION_USER_ID=
# Contato mostrado nos Termos/Privacidade.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# ═══ 5. AJUSTES DO SERVIDOR (pode deixar como está) ══════════════════
# Apaga vídeos enviados/prontos depois de N horas (o disco não enche).
OUTPUT_TTL_HOURS=24
# Sem limite de tamanho de arquivo. Para limitar: MAX_UPLOAD_GB=50
MAX_UPLOAD_GB=0
# Só se usar TRANSCRIBE_PROVIDER=whisper-local (grátis, roda na VPS, mais lento).
WHISPER_MODEL=base
