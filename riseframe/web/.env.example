# Frontend do Riseframe (Vite). Variáveis de BUILD (começam com VITE_).
#
# Deixe VAZIO quando o frontend e o backend rodam juntos (mesmo domínio, ex.: Render).
# Preencha com a URL do backend quando o frontend está separado (ex.: Netlify):
#
#   VITE_API_URL=https://riseframe-api.onrender.com
#
# (sem barra no final; o app adiciona /api sozinho)
VITE_API_URL=
