# ─── Riseframe server ───────────────────────────────────────────────
# Copie para server/.env e ajuste. TODAS as chaves são opcionais: sem elas o
# sistema roda de ponta a ponta com provedores locais/mock e pula o B-roll.

PORT=4000
# Origem permitida do frontend (CORS)
CORS_ORIGIN=http://localhost:5174

# Retenção dos arquivos renderizados, em horas (limpeza automática). 0 = nunca.
OUTPUT_TTL_HOURS=24
# Tamanho máximo de upload em MB
MAX_UPLOAD_MB=512

# ─── Transcrição ────────────────────────────────────────────────────
# Provedor: mock | openai | deepgram | assemblyai | whisper-local
TRANSCRIBE_PROVIDER=mock
# openai (Whisper API): https://platform.openai.com
OPENAI_API_KEY=
# deepgram: https://deepgram.com
DEEPGRAM_API_KEY=
# assemblyai: https://www.assemblyai.com
ASSEMBLYAI_API_KEY=
# whisper-local: usa faster-whisper via Python (WHISPER_MODEL=tiny|base|small|medium)
WHISPER_MODEL=base

# ─── Análise por IA (temas / momentos de B-roll) ────────────────────
# Provedor: heuristic | openai | anthropic
ANALYZE_PROVIDER=heuristic
ANTHROPIC_API_KEY=

# ─── B-roll (banco de mídia gratuito) ───────────────────────────────
# Pexels tem licença livre: https://www.pexels.com/api/
PEXELS_API_KEY=
