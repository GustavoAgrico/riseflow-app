EVOLUTION_URL=https://evolution-api-production-7eaf.up.railway.app
EVOLUTION_KEY=sua-evolution-api-key
EVOLUTION_INSTANCE=test
JWT_SECRET=gere-uma-string-aleatoria-forte
PORT=3333
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
WEBHOOK_TOKEN=

# Supabase — necessário para o MOTOR DE FUNIS (server/flowEngine.js).
# A SERVICE ROLE KEY ignora RLS (o webhook é global e precisa ler funis de qualquer usuário).
# Pegue em: Supabase Dashboard → Project Settings → API → service_role (secret).
# NUNCA exponha essa key no frontend.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude AI — geração de mensagens de campanha
# Gere em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# SMTP da PLATAFORMA (fallback de e-mail) — usado quando o dono NÃO conectou o
# canal Email em Integrações. Ex.: convite de equipe sai deste endereço. Sem
# isto, e-mails só saem se o dono configurar o próprio SMTP na tela Integrações.
# Exemplos: Gmail (senha de app), Brevo, Resend SMTP, SendGrid, Mailgun.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RiseFlow <no-reply@seu-dominio.com>

# Cifragem dos tokens de canal em repouso (integrations.config: WhatsApp Cloud,
# Meta page_token, Telegram bot_token). AES-256-GCM. 32 bytes em hex.
# Gere com:  openssl rand -hex 32
# Se vazia, os tokens são gravados em TEXTO PURO (retrocompatível, mas sem cifragem).
# Ao definir, reconecte os canais para recifrar os tokens já salvos.
TOKEN_ENC_KEY=
