# RiseFlow — variáveis de ambiente (frontend Vite)
# Copie para .env e preencha com seus valores reais. NUNCA commite o .env.

# Backend proxy do RiseFlow (esconde a apikey da Evolution).
# Em dev o Vite proxia /api → :3333. Em produção, use a URL pública do backend.
VITE_API_URL=http://localhost:3001

# Supabase (a anon key é pública por design, protegida por RLS).
VITE_SUPABASE_URL=sua_url_aqui
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Opcional: URL do Socket.io (default http://localhost:3333).
# VITE_SOCKET_URL=http://localhost:3333

# As credenciais da Evolution (URL/KEY/INSTANCE) ficam APENAS em /server/.env.
